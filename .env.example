# Supabase (Stage 3)
SUPABASE_URL=
SUPABASE_KEY=

# Google Calendar (Stage 7) — which calendar to read/write (a calendar ID or a Gmail address)
GOOGLE_CALENDAR_ID=

# Google Calendar auth. LOCALLY: leave GOOGLE_OAUTH_TOKEN unset — the app uses
# credentials.json + a cached token.json in the project folder. DEPLOYED: there's no
# browser and no durable disk, so paste the whole token.json payload here instead.
# Generate it by running `python calendar_service.py` on a local machine.
# GOOGLE_OAUTH_TOKEN=

# Anthropic / AI assistant (Stage 11)
ANTHROPIC_API_KEY=

# Instacart — NOT USED. The Developer Platform API (which these vars were for) is
# closed to new signups. Stage 9 is now just an in-app "Copy list" text export;
# real Instacart ordering comes via the fig-mcp.instacart.com remote MCP server
# (consumer OAuth, no key) driven by the assistant. See build plan Stage 9 + Stage 11b.
